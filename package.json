{
  "name": "ai-nids",
  "version": "1.0.0",
  "private": true,
  "description": "Explainable Network Intrusion Detection System",
  "scripts": {
    "postinstall": "cd frontend && npm install",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build && mkdir -p ../dist && cp -r dist/* ../dist/",
    "start": "cd frontend && npm run dev",
    "backend": "PYTHONPATH=. ./.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload"
  }
}
